#!/usr/bin/env bash
# One-time setup for the claude-sandboxed host-side Playwright MCP browser
# service. Installs the systemd user unit and enables/starts it, so a visible
# host browser is available to sandboxed agents that have browser.enabled=true.
#
# Usage (after installing claude-sandboxed):
#   /usr/local/share/claude-sandboxed/install-playwright-systemd
#
# This is the only manual step; after this the service auto-starts at login and
# the browser itself is launched on demand when an agent drives it.

set -euo pipefail

UNIT="claude-sandboxed-playwright"
BASE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC="$BASE/systemd/$UNIT.service"
DEST_DIR="${SYSTEMD_USER_DIR:-$HOME/.config/systemd/user}"
DEST="$DEST_DIR/$UNIT.service"

if [[ ! -f "$SRC" ]]; then
    echo "error: unit not found at $SRC" >&2
    exit 1
fi

mkdir -p "$DEST_DIR"
install -m644 "$SRC" "$DEST"
echo "Installed unit to $DEST"

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload
    if systemctl --user enable --now "$UNIT" 2>/dev/null; then
        echo "Enabled + started $UNIT (auto-starts on login)."
        echo "  systemctl --user --no-pager status $UNIT    # check status"
    else
        echo "Unit installed but could not be enabled/started; run manually:"
        echo "  systemctl --user enable --now $UNIT"
    fi
else
    echo "systemctl not found; enable the unit manually when systemd is available:"
    echo "  systemctl --user daemon-reload"
    echo "  systemctl --user enable --now $UNIT"
fi

echo "Done. To expose the browser to a sandbox agent, set in the config:"
echo "  browser:"
echo "    enabled: true"