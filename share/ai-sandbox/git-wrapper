#!/bin/bash
# Git wrapper for ai-sandbox.
# Blocks destructive git operations (history rewriting, work discarding, pushes).
# Allows non-destructive and appending-only operations.
#
# Set REAL_GIT env var to override the path to the real git binary (for testing).

REAL_GIT="${REAL_GIT:-/usr/bin/git}"

# If no args, pass through (shows git help).
if [[ $# -eq 0 ]]; then
    exec "$REAL_GIT"
fi

# Parse global flags to find the subcommand (first positional arg).
# Handles value-taking global flags (-C, -c, --git-dir, --work-tree, --namespace,
# --super-prefix, --config-env); other -X / --X flags are skipped.
subcommand=""
subcommand_idx=0
i=1
while [[ $i -le $# ]]; do
    arg="${!i}"
    case "$arg" in
        -C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env)
            # Takes a value in the next arg.
            ((i += 2))
            continue
            ;;
        -*)
            # Other global flag, skip.
            ((i++))
            continue
            ;;
        *)
            subcommand="$arg"
            subcommand_idx=$i
            break
            ;;
    esac
done

# If no subcommand found, pass through (e.g. git --version, git --help).
if [[ -z "$subcommand" ]]; then
    exec "$REAL_GIT" "$@"
fi

# Block helper: print security message and exit 1.
block() {
    echo "[SECURITY] $1" >&2
    echo "[SECURITY] This is intentional. Do not bypass it. git push is always blocked; other destructive operations are generally prohibited." >&2
    echo "[SECURITY] Reconsider whether the underlying operation is genuinely needed and aligns with the user's intent, rather than the specific command you attempted." >&2
    echo "[SECURITY] The sandbox is for autonomous work. Do not ask the user to authorize individual operations; escalate only as a last resort if no in-sandbox approach exists." >&2
    exit 1
}

# --- Local-override mode ---
# When enabled, only push is blocked; user policy file and built-in
# default blocks are skipped entirely.
ALLOW_LOCAL="${SANDBOX_GIT_ALLOW_LOCAL_OPERATIONS:-false}"
if [[ "$ALLOW_LOCAL" == "true" ]]; then
    if [[ "$subcommand" == "push" ]]; then
        echo "[SECURITY] git push is blocked by ai-sandbox." >&2
        echo "[SECURITY] Local-override mode is active: all local operations are allowed; only remote-affecting operations (push) are blocked." >&2
        echo "[SECURITY] Reconsider whether pushing to remote aligns with the user's intent." >&2
        echo "[SECURITY] The sandbox is for autonomous work. Do not ask the user to authorize individual operations; escalate only as a last resort if no in-sandbox approach exists." >&2
        exit 1
    fi
    exec "$REAL_GIT" "$@"
fi

# --- Presets ---
# A preset is the strict baseline (the block checks below) plus a set of named
# relaxations. "strict" relaxes nothing. "daily" (default) relaxes bounded
# working-tree discards and commit --amend; "relaxed" additionally relaxes
# reflog-recoverable local history edits. Unknown preset names fall back to
# strict (no relaxations) as a fail-safe. See docs/configuration.md.
preset_flags() {
    case "${1:-daily}" in
        daily)   printf 'discard amend' ;;
        relaxed) printf 'discard amend branch_delete_force tag_force stash_drop clean rm' ;;
        *)       : ;;  # strict or unknown -> no relaxations
    esac
}

# True when the active preset relaxes the named rule.
has_flag() {
    [[ -n "$PRESET_FLAGS" && " $PRESET_FLAGS " == *" $1 "* ]]
}

PRESET_FLAGS="$(preset_flags "${SANDBOX_GIT_PRESET:-daily}")"

# --- User policy file (patches the default policy) ---
# Format: [allow] and [block] section headers, one regex per line.
# Lines starting with # or empty are skipped. Regex is ERE, matched
# against "subcommand args..." (global flags stripped). Substring match
# by default; use ^ and $ to anchor.
POLICY_FILE="${GIT_POLICY_FILE:-/etc/ai-sandbox/git-policy.conf}"
if [[ -f "$POLICY_FILE" ]]; then
    # Build command string for regex matching.
    cmd_args="$subcommand"
    for ((j=subcommand_idx+1; j<=$#; j++)); do
        cmd_args="$cmd_args ${!j}"
    done
    section=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        case "$line" in
            "[allow]") section="allow"; continue ;;
            "[block]") section="block"; continue ;;
        esac
        if [[ "$section" == "allow" ]]; then
            if [[ "$cmd_args" =~ $line ]]; then
                exec "$REAL_GIT" "$@"
            fi
        elif [[ "$section" == "block" ]]; then
            if [[ "$cmd_args" =~ $line ]]; then
                block "matches user block rule: $line"
            fi
        fi
    done < "$POLICY_FILE"
fi

# --- Policy checks ---

case "$subcommand" in
    push|reset|rebase|filter-branch|filter-repo|config|commit-tree|update-ref|replace|fast-import|prune|symbolic-ref)
        block "git $subcommand is blocked by ai-sandbox."
        ;;
    clean)
        # Deletes untracked files (unrecoverable); relaxed only by "relaxed".
        if ! has_flag clean; then
            block "git clean is blocked by ai-sandbox."
        fi
        ;;
    reflog)
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                expire|delete)
                    block "git reflog ${!j} is blocked by ai-sandbox."
                    ;;
            esac
        done
        ;;
    notes)
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                remove|prune)
                    block "git notes ${!j} is blocked by ai-sandbox."
                    ;;
            esac
        done
        ;;
    worktree)
        # Allow safe remove: git itself refuses to remove a worktree with
        # untracked/modified files unless forced, and no objects/refs are
        # deleted (gc --prune is blocked). Block force forms (-f, --force,
        # doubled for locked/submodule worktrees). prune stays blocked:
        # other host worktrees' directories are not visible inside the
        # sandbox, so prune would consider them stale and delete their
        # admin entries under .git/worktrees, breaking them on the host.
        wt_remove=false
        wt_prune=false
        has_force=false
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            arg="${!j}"
            case "$arg" in
                remove) wt_remove=true ;;
                prune) wt_prune=true ;;
                --force) has_force=true ;;
                -[!-]*)
                    [[ "$arg" == *f* ]] && has_force=true
                    ;;
            esac
        done
        if $wt_prune; then
            block "git worktree prune is blocked by ai-sandbox."
        fi
        if $wt_remove && $has_force; then
            block "git worktree remove --force is blocked by ai-sandbox."
        fi
        ;;
    commit)
        # --amend/--reset-author rewrite only the latest commit (reflog-
        # recoverable); relaxed by "amend" (daily, relaxed).
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                --amend|--reset-author)
                    if ! has_flag amend; then
                        block "git commit ${!j} is blocked by ai-sandbox."
                    fi
                    ;;
            esac
        done
        ;;
    tag)
        # Block any force form (-f, --force, -df, --delete --force) unless
        # relaxed by "tag_force". Safe delete (-d, --delete without force) is
        # always allowed: the tagged commit stays in the object db and reflog;
        # gc --prune is blocked.
        has_force=false
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            arg="${!j}"
            case "$arg" in
                --force)
                    has_force=true
                    ;;
                -[!-]*)
                    [[ "$arg" == *f* ]] && has_force=true
                    ;;
            esac
        done
        if $has_force && ! has_flag tag_force; then
            block "git tag --force is blocked by ai-sandbox."
        fi
        ;;
    branch)
        # Force delete (-D, -df, --delete --force) is relaxed by
        # "branch_delete_force"; safe delete (-d, --delete) is always allowed
        # (git itself refuses to delete unmerged branches, and commits stay
        # recoverable via reflog). Force MOVE/reset (-f / --force without
        # delete) rewrites the branch ref and is always blocked, like
        # reset/update-ref.
        has_delete=false
        has_force=false
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            arg="${!j}"
            case "$arg" in
                --delete)
                    has_delete=true
                    ;;
                --force)
                    has_force=true
                    ;;
                -[!-]*)
                    [[ "$arg" == *[dD]* ]] && has_delete=true
                    [[ "$arg" == *[Df]* ]] && has_force=true
                    ;;
            esac
        done
        if $has_force && ! $has_delete; then
            block "git branch --force (move/reset) is blocked by ai-sandbox."
        fi
        if $has_delete && $has_force && ! has_flag branch_delete_force; then
            block "git branch --delete --force is blocked by ai-sandbox."
        fi
        ;;
    stash)
        # drop/clear discard stashed state; relaxed by "stash_drop".
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                drop|clear)
                    if ! has_flag stash_drop; then
                        block "git stash ${!j} is blocked by ai-sandbox."
                    fi
                    ;;
            esac
        done
        ;;
    checkout)
        # -B force-resets a branch ref (always blocked). -f / --force /
        # -- <pathspec> discard working-tree changes; relaxed by "discard".
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            arg="${!j}"
            case "$arg" in
                --force)
                    if ! has_flag discard; then
                        block "git checkout $arg is blocked by ai-sandbox."
                    fi
                    ;;
                --)
                    if ! has_flag discard; then
                        block "git checkout -- <pathspec> is blocked by ai-sandbox."
                    fi
                    ;;
                -[!-]*)
                    if [[ "$arg" == *B* ]]; then
                        block "git checkout $arg is blocked by ai-sandbox."
                    elif [[ "$arg" == *f* ]]; then
                        if ! has_flag discard; then
                            block "git checkout $arg is blocked by ai-sandbox."
                        fi
                    fi
                    ;;
            esac
        done
        ;;
    restore)
        # restore only touches the working tree and index (committed content
        # intact); --worktree / -W are relaxed by "discard".
        if ! has_flag discard; then
            for ((j=subcommand_idx+1; j<=$#; j++)); do
                arg="${!j}"
                case "$arg" in
                    --worktree)
                        block "git restore $arg is blocked by ai-sandbox."
                        ;;
                    -[!-]*)
                        if [[ "$arg" == *W* ]]; then
                            block "git restore $arg is blocked by ai-sandbox."
                        fi
                        ;;
                esac
            done
        fi
        ;;
    switch)
        # -C / --force-create reset a branch ref (always blocked).
        # --discard-changes / --discard discard working changes; relaxed by
        # "discard".
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            arg="${!j}"
            case "$arg" in
                --dis*)
                    if ! has_flag discard; then
                        block "git switch $arg is blocked by ai-sandbox."
                    fi
                    ;;
                --force-c*)
                    block "git switch $arg is blocked by ai-sandbox."
                    ;;
                -[!-]*)
                    if [[ "$arg" == *C* ]]; then
                        block "git switch $arg is blocked by ai-sandbox."
                    fi
                    ;;
            esac
        done
        ;;
    rm)
        # rm without --cached deletes a tracked file and stages the deletion
        # (content remains in HEAD); relaxed by "rm".
        has_cached=false
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                --cac*)
                    has_cached=true
                    ;;
            esac
        done
        if ! $has_cached && ! has_flag rm; then
            block "git rm without --cached is blocked by ai-sandbox."
        fi
        ;;
    gc)
        for ((j=subcommand_idx+1; j<=$#; j++)); do
            case "${!j}" in
                --pru*)
                    block "git gc ${!j} is blocked by ai-sandbox."
                    ;;
            esac
        done
        ;;
esac

# All checks passed, exec real git.
exec "$REAL_GIT" "$@"
