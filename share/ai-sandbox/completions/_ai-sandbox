#compdef ai-sandbox asb asb-claude asb-codex asb-opencode
# zsh completion for ai-sandbox and its aliases. Keep in sync with the
# launcher's --help text when options, tools, or aliases change (see
# docs/development.md).

_ai-sandbox() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Show help]'
        '(-V --version)'{-V,--version}'[Show version]'
        '--tool=[Select the tool]:tool:(claude codex opencode)'
        '--allow-local-git[Block only git push; allow other local git operations]'
    )
    _arguments -s -S $opts \
        '1:workspace:_files -/' \
        '*::tool arg:'
}

_ai-sandbox "$@"