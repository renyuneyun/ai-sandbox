#compdef ai-sandbox asb asb-claude asb-codex asb-opencode
# zsh completion for ai-sandbox and its aliases. Keep in sync with the
# launcher's --help text when options, tools, or aliases change (see
# docs/development.md).

_ai-sandbox() {
    if [[ "${words[2]:-}" == serve ]]; then
        _arguments -s -S \
            '2:action:(start stop attach)' \
            '--tool=[Select the tool]:tool:(opencode)' \
            '--git-preset=[Git policy preset]:preset:(strict daily relaxed)' \
            '--hostname=[Server listen address]:address:(all lo)' \
            '--port=[Server port]:port:' \
            '--headless[API-only server (v1 only; no-op for v2)]' \
            '--allow-local-git[Block only git push]' \
            '*:workspace:_files -/'
        return
    fi
    if [[ "${words[2]:-}" == openchamber ]]; then
        _arguments -s -S \
            '2:action:(start stop)' \
            '--tool=[Select the tool]:tool:(opencode)' \
            '--git-preset=[Git policy preset]:preset:(strict daily relaxed)' \
            '--hostname=[Server listen address]:address:(all lo)' \
            '--port=[Server port]:port:' \
            '--ui-port=[OpenChamber UI port]:port:' \
            '--ui-host=[OpenChamber UI listen address]:address:(all lo)' \
            '--keep-server[Stop the UI but leave the server running (openchamber stop)]' \
            '--allow-local-git[Block only git push]' \
            '*:workspace:_files -/'
        return
    fi
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Show help]'
        '(-V --version)'{-V,--version}'[Show version]'
        '--tool=[Select the tool]:tool:(claude codex opencode)'
        '--git-preset=[Git policy preset]:preset:(strict daily relaxed)'
        '--runtime=[Sandbox backend]:backend:(docker bwrap)'
        '--read-home[Make the whole real home readable (bwrap only)]'
        '--allow-local-git[Block only git push; allow other local git operations]'
    )
    _arguments -s -S $opts \
        '1:workspace:_files -/' \
        '*::tool arg:'
    if (( CURRENT == 2 )); then
        compadd serve openchamber
    fi
}

_ai-sandbox "$@"
