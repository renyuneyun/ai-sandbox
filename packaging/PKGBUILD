# Maintainer: renyuneyun (Rui Zhao) <email@ryey.icu>
pkgname=ai-sandbox
pkgver=0.5.0
pkgrel=1
pkgdesc="Sandboxed coding-agent runtime (Claude Code, Codex, OpenCode) with git push protection"
arch=('any')
url="https://github.com/renyuneyuny/claude-sandboxed"
license=('Apache')
depends=('docker')
optdepends=('nodejs: npx runtime for the optional on-host Playwright MCP browser service'
            'chromium: headed browser driven by the optional Playwright MCP browser service'
            'playwright-mcp: the Playwright MCP server for the optional on-host browser service (AUR)')
source=()
sha256sums=()

_repodir="$(realpath ..)"

package() {
    install -Dm755 "$_repodir/bin/ai-sandbox" "$pkgdir/usr/bin/ai-sandbox"
    install -Dm644 "$_repodir/share/ai-sandbox/docker-compose.yml" "$pkgdir/usr/share/ai-sandbox/docker-compose.yml"
    install -Dm755 "$_repodir/share/ai-sandbox/git-wrapper" "$pkgdir/usr/share/ai-sandbox/git-wrapper"
    install -Dm644 "$_repodir/share/ai-sandbox/config.example.yaml" "$pkgdir/usr/share/ai-sandbox/config.example.yaml"
    # systemd user unit installed to the packaged user-unit directory.
    install -Dm644 "$_repodir/share/ai-sandbox/systemd/ai-sandbox-playwright.service" "$pkgdir/usr/lib/systemd/user/ai-sandbox-playwright.service"
}
